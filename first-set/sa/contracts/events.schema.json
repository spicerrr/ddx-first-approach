{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Аналитические события «Первого подхода»",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "scenarioVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "scenarioVersion",
    "occurredAt",
    "eventType"
  ],
  "oneOf": [
    {
      "properties": {
        "eventType": {
          "enum": [
            "first_approach_exposed",
            "first_approach_started",
            "first_approach_completed",
            "first_approach_skipped"
          ]
        }
      }
    },
    {
      "properties": {
        "eventType": {
          "enum": [
            "first_approach_stage_started",
            "first_approach_stage_completed"
          ]
        },
        "stage": {
          "$ref": "#/$defs/stage"
        }
      },
      "required": [
        "stage"
      ]
    },
    {
      "properties": {
        "eventType": {
          "enum": [
            "first_approach_hint_requested",
            "first_approach_demo_opened"
          ]
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-zA-Z0-9_-]*$"
        }
      },
      "required": [
        "stage",
        "concept"
      ]
    },
    {
      "properties": {
        "eventType": {
          "const": "first_approach_hint_level_reached"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*[a-zA-Z0-9_-]*$"
        },
        "hintLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      },
      "required": [
        "stage",
        "concept",
        "hintLevel"
      ]
    },
    {
      "properties": {
        "eventType": {
          "const": "training_cta_clicked"
        },
        "source": {
          "enum": [
            "club",
            "start-point",
            "station",
            "finish"
          ]
        },
        "training": {
          "enum": [
            "intro",
            "smart-start"
          ]
        }
      },
      "required": [
        "source",
        "training"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "stage": {
      "enum": [
        "DUMBBELLS",
        "BARBELL",
        "BENCH",
        "INVENTORY"
      ]
    }
  }
}
